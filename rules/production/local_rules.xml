<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <rule id="100100" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\wscript\.exe$</field>
    <description>PowerShell launched by Windows Script Host</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1059.005</id>
    </mitre>
    <group>powershell,script_execution,suspicious_execution,</group>
  </rule>

  <rule id="100102" level="9">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-WindowStyle\s+Hidden|-w\s+Hidden)</field>
    <description>PowerShell launched with hidden window</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1564.003</id>
    </mitre>
    <group>powershell,hidden_window,suspicious_execution,</group>
  </rule>

  <rule id="100104" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(Invoke-WebRequest|\biwr\b|\bwget\b|\bcurl\b)</field>
    <description>PowerShell launched with web download command</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1105</id>
    </mitre>
    <group>powershell,network_activity,command_and_control,suspicious_execution,</group>
  </rule>

   <rule id="100106" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\mshta\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)https?://</field>
    <description>MSHTA launched with remote URL</description>
    <mitre>
      <id>T1218.005</id>
    </mitre>
    <group>mshta,lolbin,suspicious_execution,defense_evasion,</group>
   </rule>

</group>